{
  "name": "raju-codes-mission",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cinematic 3D space-journey developer portfolio (raju-codes.me).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "spikes:assets": "node scripts/fetch-spike-assets.ts",
    "build": "npm run typecheck && vite build && vite build --ssr src/brief/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender-brief.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/vitest.ts run",
    "test:watch": "node scripts/vitest.ts",
    "test:e2e": "playwright test",
    "content:report": "node scripts/content-report.ts",
    "content:check": "node scripts/content-report.ts --strict",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:spikes": "playwright test -c playwright.spikes.config.ts",
    "assets:fetch": "node scripts/fetch-polyhaven.ts",
    "assets:optimize": "node scripts/optimize-assets.ts",
    "shots": "node scripts/capture-shots.ts",
    "assets:mixamo": "node scripts/convert-mixamo.ts",
    "assets:nasa": "node scripts/fetch-nasa.ts",
    "assets:projects": "node scripts/prepare-project-images.ts",
    "assets:ship": "node scripts/convert-fbx.ts raw-assets/helveta-space-battle-ship/source/HV.fbx raw-assets/helveta-space-battle-ship/hv.raw.glb && node scripts/optimize-ship.ts raw-assets/helveta-space-battle-ship/hv.raw.glb public/assets/models/helvela.glb 60000"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "draco3dgltf": "^1.5.9",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
